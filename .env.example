# Model gateway (OpenAI-compatible, must support tool calling).
# Liara AI:  https://ai.liara.ir/api/<workspaceID>/v1
# GapGPT:    https://api.gapgpt.app/v1
LIARA_AI_BASE_URL=
LIARA_AI_API_KEY=
# Default model id on that gateway
LIARA_AI_MODEL=
# Models users can pick in Settings: "id:Label,id:Label"
YARA_MODELS=

# Encrypts users' stored Liara tokens. Set a long random value in production.
# If unset, a key is generated next to the database (data/secret.key).
APP_SECRET=
# SQLite file (default data/yara.db). On Liara, data/ is the mounted disk.
DATABASE_PATH=
# Per-user model requests per hour (protects the operator's AI key)
CHAT_REQUESTS_PER_HOUR=120
